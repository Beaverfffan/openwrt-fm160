#!/bin/sh
# fm160-qmi-at —— 零依赖 AT 发送器（BusyBox 可用）
#
# 用途：把 **Fibocom 私有扩展 AT**（官方 V2.3/V2.5 文档里没有的那些）写进模组。
#       目前唯一必需的场景是 `AT+GTAUTOCONNECT=0`（见 README「关键前提」）。
#
# ★★ 通路选择（这是本脚本的重点，踩过坑）：
#   在 iStoreOS/H69K 上，**`ubus-at-daemon` 会独占所有 /dev/ttyUSB***。
#   直接往 tty 写 AT **得不到任何应答**（不是口错，是被占）。
#   正确顺序：
#     ① `ubus call fm160 at '{"cmd":"AT+…"}'`  ← 我们的 fm160d 暴露的方法，它持有端口的 lease
#     ② `ubus call at-daemon sendat '{...,"owner":"…"}'`  ← 通用 at-daemon（需 owner/lease）
#     ③ 直接写 tty（仅在**没有任何 daemon 持有**时可用）
#   本脚本按 ①→③ 依次尝试，并把**实际走通的通路**打印出来，避免"以为发了其实没发"。
#
#   用法：fm160-qmi-at routes   看清楚当前哪条通路可用、谁持有端口
#         （routes 会往候选口发一条裸 `AT` 做探测，无副作用）
#
# 用法：
#   fm160-qmi-at routes                诊断：AT 口持有者 + 可用通路
#   fm160-qmi-at get                   读 AT+GTAUTOCONNECT?
#   fm160-qmi-at off                   ★ 写 AT+GTAUTOCONNECT=0（本脚本的主要目的）
#   fm160-qmi-at at 'AT+GTWWAN?'       发任意一条命令
#   fm160-qmi-at reset                 AT+CFUN=1,1（让上面的写操作生效）

ATTO="${ATTO:-5}"
TMP=/tmp/fm160-at.$$
CAND="/dev/ttyUSB2 /dev/ttyUSB4 /dev/ttyUSB1 /dev/ttyUSB3 /dev/ttyUSB0 /dev/ttyUSB5 /dev/ttyUSB6"
trap 'rm -f "$TMP"' EXIT INT TERM

have() { command -v "$1" >/dev/null 2>&1; }

# ---------- 通路 ①：fm160d 的 ubus 方法（首选） ----------
at_via_fm160() {
	have ubus || return 1
	ubus list fm160 >/dev/null 2>&1 || return 1
	_o=$(ubus call fm160 at "{\"cmd\":\"$1\",\"timeout\":$ATTO}" 2>&1)
	case "$_o" in
		*'"status": "ok"'*|*'"status":"ok"'*) ;;
		*) printf '%s\n' "$_o" >&2; return 1 ;;
	esac
	if have jsonfilter; then
		printf '%s' "$_o" | jsonfilter -e '@.response'
	else
		printf '%s' "$_o"
	fi
	return 0
}

# ---------- 通路 ③：直接写 tty（无 daemon 时才可能成功） ----------
probe_tty() {
	_t="$1"
	[ -c "$_t" ] || return 1
	stty -F "$_t" 115200 raw -echo clocal 2>/dev/null
	: > "$TMP"
	cat "$_t" > "$TMP" 2>/dev/null &
	_p=$!
	sleep 1
	printf 'AT\r' > "$_t" 2>/dev/null
	sleep 1
	kill "$_p" 2>/dev/null
	wait "$_p" 2>/dev/null
	grep -q 'OK' "$TMP" 2>/dev/null && { printf '%s' "$_t"; return 0; }
	return 1
}

discover_tty() {
	for _t in $CAND; do
		_r=$(probe_tty "$_t") && { printf '%s' "$_r"; return 0; }
	done
	return 1
}

at_via_tty() {
	_t=$(discover_tty) || return 1
	: > "$TMP"
	cat "$_t" > "$TMP" 2>/dev/null &
	_p=$!
	sleep 1
	printf '%s\r' "$1" > "$_t" 2>/dev/null
	sleep 5
	kill "$_p" 2>/dev/null
	wait "$_p" 2>/dev/null
	tr -d '\r' < "$TMP" 2>/dev/null
	return 0
}

# ---------- 统一入口 ----------
at_send() {
	if at_via_fm160 "$1"; then return 0; fi
	if at_via_tty "$1"; then return 0; fi
	return 1
}

# 列出谁持有 ttyUSB（遍历 /proc/*/fd；不用 ps|grep，会自匹配）
holders() {
	for _p in /proc/[0-9]*; do
		for _fd in "$_p"/fd/*; do
			_l=$(readlink "$_fd" 2>/dev/null) || continue
			case "$_l" in
				*/ttyUSB*) printf '  pid=%s comm=%s -> %s\n' \
					"${_p#/proc/}" "$(cat "$_p/comm" 2>/dev/null)" "$_l" ;;
			esac
		done
	done | sort -u
}

cmd="${1:-help}"
case "$cmd" in
routes)
	echo "== 1) 设备节点 =="
	for _t in $CAND; do [ -c "$_t" ] && echo "  $_t"; done
	echo "== 2) 当前持有者（遍历 /proc/*/fd）=="
	_h=$(holders); [ -n "$_h" ] && echo "$_h" || echo "  （无人持有）"
	echo "== 3) 通路可用性 =="
	if have ubus && ubus list fm160 >/dev/null 2>&1; then
		echo "  ①  ubus fm160.at        ← ★ 可用（首选）"
	else
		echo "  ①  ubus fm160.at        ← 不可用（fm160d 没在跑？）"
	fi
	if have ubus && ubus list at-daemon >/dev/null 2>&1; then
		echo "  ②  ubus at-daemon       ← 存在（需 owner/lease，本脚本未用）"
	else
		echo "  ②  ubus at-daemon       ← 不存在"
	fi
	_t=$(discover_tty)
	if [ -n "$_t" ]; then echo "  ③  直接写 tty           ← 可用（$_t）"
	else echo "  ③  直接写 tty           ← 不可用（端口被 daemon 占用，属正常）"; fi
	;;
get)
	_o=$(at_send 'AT+GTAUTOCONNECT?') || { echo "AT 通路不可用；先跑 fm160-qmi-at routes" >&2; exit 1; }
	printf '%s\n' "$_o"
	;;
off)
	echo "## 写前现值（先读再写）"
	at_send 'AT+GTAUTOCONNECT?' || { echo "AT 通路不可用；先跑 fm160-qmi-at routes" >&2; exit 1; }
	echo "## 写入 AT+GTAUTOCONNECT=0"
	at_send 'AT+GTAUTOCONNECT=0' || exit 1
	echo "## 回读确认"
	at_send 'AT+GTAUTOCONNECT?' || exit 1
	echo
	echo "# 若现值本就是 0，无需复位；若刚从 1 改成 0，执行：fm160-qmi-at reset"
	;;
reset)
	echo "# 即将 AT+CFUN=1,1（模组掉线重枚举）"
	at_send 'AT+CFUN=1,1' || { echo "AT 通路不可用" >&2; exit 1; }
	echo "# 复位后 QMI 服务需 150–200 s 才应答；用 fm160-qmi status 观察"
	;;
at)
	shift
	[ -n "${1:-}" ] || { echo "用法: $0 at '<AT 命令>'" >&2; exit 1; }
	at_send "$*" || { echo "AT 通路不可用；先跑 fm160-qmi-at routes" >&2; exit 1; }
	;;
*)
	sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'
	;;
esac
