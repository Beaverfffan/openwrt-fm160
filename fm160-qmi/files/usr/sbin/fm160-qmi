#!/bin/sh
# /usr/sbin/fm160-qmi —— Fibocom FM160 的【开源】QMI 拨号器（uqmi 版）
#
# ═══════════════════════════════════════════════════════════════════════════
# 为什么有这个文件
# ───────────────────────────────────────────────────────────────────────────
# Fibocom 官方《QMI_WWAN 驱动集成及拨号指南 V2.3》《QMI拨号工具使用指南 V2.5》
# 提供的拨号工具（fibocom-dial / QConnectManager / quectel-CM-M）是**闭源二进制**。
# 本文件用 OpenWrt 自带的 **uqmi**（开源，OpenWrt 官方 netifd 的 QMI proto 后端）
# 复刻同一套 QMI 初始化序列，地址交给 **netifd**（开源 udhcpc + dhcp.script）。
# ⇒ 整条链路无任何厂商二进制。
#
# 与 quectel-CM 的逐条对应（CM 侧日志取自真机 /tmp/qcm123.log）
# ───────────────────────────────────────────────────────────────────────────
#   QMICTL_SYNC / GET_VERSION / GET_CLIENT_ID×N   → uqmi 内部自动完成
#   QMIWDS_BIND_MUX_DATA_PORT {ep{2,4}, mux 0x81, client_type=tethered}
#                                                 → --bind-mux 129
#                                                   --endpoint-type hsusb --endpoint-iface 4
#   QMIWDS_GET_PROFILE_SETTINGS (pdp:1 index:1)   → --start-network --profile 1
#   QMIWDS_START_NETWORK_INTERFACE                → --start-network --ip-family $IPFAM
#                                                    （默认 unspecified = 双栈；见 IPFAM 注释）
#   QMIWDS_GET_RUNTIME_SETTINGS                   → --get-current-settings
#                                                    v4 首选仍交给 netifd(ifup)，失败再 QMI 直取；
#                                                    **v6 只能 QMI 直取**（本链路无 DHCPv6/RA）
#   QMIWDS_ADMIN_SET_DATA_FORMAT (WDS 0x0020)     → ★ **必需**！用 uqmi 的
#                                                     `--wda-set-data-format raw-ip
#                                                      --ul/dl-aggregation-protocol qmap`
#                                                     复刻（uqmi 原生带这些选项），
#                                                     详见 do_up 第 2 步的注释
#   驱动发送门 link_state                          → echo 1 > /sys/class/net/wwan0/link_state
#   CM 之后自己跑 udhcpc                          → ★ 本实现交给 netifd（ifup $NETIF），
#                                                     因为 busybox 的 /usr/share/udhcpc/default.script
#                                                     会把「网关不是本次租约」的默认路由**删掉**
#                                                     （§33.4-E 实测：曾把整机出口从 eth0 切走）；
#                                                     netifd 的 /lib/netifd/dhcp.script 是 metric 感知的。
#
# ★★ SET_DATA_FORMAT 为什么必需（这是 §34.5 那个缺口的最终答案）
# ───────────────────────────────────────────────────────────────────────────
#   真机 A/B（同一台设备、同一个驱动、同一个模组）：
#     模组复位/冷启动后：  data-aggregation-protocol = **"unknown"**，ul/dl max = 0
#       ⇒ 模组按「不分帧」发裸 IP；而驱动 qmi_wwan_f 在 bind 时强制 qmap_mode=1，
#         给每个 TX 包加 QMAP 头（mux_id 0x81），RX 侧也按 QMAP 解析
#       ⇒ 宿主 rx 恒 0；dmesg 刷
#            "net wwan0: drop skb_len=79eb larger than 1500"（伪随机长度 = 拿裸 IP 头当 QMAP 读）
#     显式设成 qmap 后：    data-aggregation-protocol = "qmap"，ul 11/8192，dl 32/16384
#       ⇒ 数据面立即成立（ping 10/10）
#   ⇒ 只调 BIND_MUX 是不够的；**必须先 SET_DATA_FORMAT**。
#
#   ★ 勘误（两条，都记在存档 §35）：
#     1. §34.5 写「uqmi 只能发 WDA 且不填 endpoint / 没有聚合字段」——**错**。
#        设备上 `uqmi --wda-set-data-format` 的帮助就有
#          --dl/ul-aggregation-protocol (tlp|qc-cm|mbim|rndis|qmap|qmapv5)
#          --dl/ul-datagram-max-count / --dl/ul-datagram-max-size / --flow-control
#        （当时是用 grep 过滤 help 输出，把这些行筛掉了而误判为"不存在"。）
#        唯一确实缺失的是 endpoint_info TLV —— 真机实测**不影响**可用性。
#     2. 「模组拒绝 QMAP、RESP 把聚合归零」—— 那只在**没有活动会话**时读到；
#        有会话时读回就是 qmap。把请求与生效值混为一谈是当时的错。
#
# ★★ 前置条件（关键！来自官方《拨号工具使用指南 V2.5》+ 真机 A/B）
# ───────────────────────────────────────────────────────────────────────────
#   AT+GTAUTOCONNECT=0
#
#   若为 1（出厂默认），模组会在开机后**自己**拉起一个 RMNET/ECM 数据呼叫，
#   此时 `AT+GTWWAN?` 回 `1,<cid>`（呼叫已激活）。该呼叫会占住 USB 数据面，
#   使宿主驱动按 QMAP 解析时读到畸形帧：
#       dmesg → "net wwan0: drop skb_len=79eb larger than 1500"（伪随机长度）
#   结果宿主 rx 恒 0，**任何**拨号器（含厂商 quectel-CM）都拿不到数据。
#
#   真机对照（同一台设备、同一个厂商驱动、同一个 CM 二进制）：
#       GTAUTOCONNECT=1, GTWWAN=1,1  →  CM 跑：ping 8/8 loss、Δrx=0   ✗
#       GTAUTOCONNECT=0, GTWWAN=0    →  CM 跑：ping 10/10、rx=750     ✓
#       GTAUTOCONNECT=0, GTWWAN=0    →  本实现：ping 10/10、Δrx=75    ✓
#
#   设置方法（模组 NVRAM 持久，设一次即可）：
#       AT+GTAUTOCONNECT=0  →  然后 AT+CFUN=1,1（或整机重启）让它生效
#     （注：该命令不在官方 V2.3/V2.5 文档里 —— 属 Fibocom 私有扩展 AT，
#       手册 11.1.5 的注记是 "takes effect after reboot"，真机实测吻合。）
#
# 用法
# ───────────────────────────────────────────────────────────────────────────
#   fm160-qmi up        起链路（含 ifup $NETIF）
#   fm160-qmi down      停链路（stop-network + 关发送门 + ifdown）
#   fm160-qmi status    只读状态
#   fm160-qmi watch     守护模式（procd 用）：每 15 s 健康检查，连续 3 次失败则重拨
#
# 可覆盖的环境变量：FM160_WDM / FM160_IF / FM160_NETIF / FM160_MUX / FM160_EPTYPE
#                   FM160_EPIFACE / FM160_PROFILE / FM160_APN / FM160_TIMEOUT
#                   FM160_IPFAM（ipv4|ipv6|unspecified）  FM160_METRIC
# 红线：不切 USB 模式、不 rmmod、不刷机、不动 netifd 之外的路由。
# ═══════════════════════════════════════════════════════════════════════════

set -u

D=${FM160_WDM:-/dev/cdc-wdm0}
IF=${FM160_IF:-wwan0}
NETIF=${FM160_NETIF:-2_1}
MUX=${FM160_MUX:-129}
EPE=${FM160_EPTYPE:-hsusb}
EPI=${FM160_EPIFACE:-4}
PROFILE=${FM160_PROFILE:-1}
APN=${FM160_APN:-}
# ★ 会话的 IP family：ipv4 | ipv6 | unspecified
#   语义（uqmi 源码依据，commands-wds.c:192-204 / 264-268）：
#     - `--ip-family <v>` 是 `--start-network` 的**子选项**，写进本次 start-network 请求；
#     - `--set-ip-family <v>` 是**独立命令**，只改 wds_sn_req.ip_family_preference，
#       影响**之后**的 start-network。
#   而 uqmi 的 main()（uqmi.c:125-167）是「getopt 先把所有选项收进命令队列，
#   解析完再 uqmi_run_commands() 顺序执行」。
#   ⇒ 本脚本统一用**子选项**写法（与 OpenWrt 官方 qmi.sh 的意图一致，且不依赖顺序）。
#   ★★ 实测结论（137 / 137b 四变体对照，真机取证）：
#       **一次 QMI 会话只给一个 IP 族**，不是双栈。
#       - 不传 `--ip-family`      → 模组默认回 `"ip-family":"ipv6"`（**v6-only**）
#       - `--ip-family ipv4`      → v4-only
#       - `--ip-family ipv6`      → v6-only
#       - `--ip-family unspecified` → 同 ipv6（v6-only）
#       （注意：模组**网侧** PDP 每个变体都同时有 v4+v6，`AT+CGPADDR=1` 可证；
#         但 QMI 一次会话只把一个族交给主机 ⇒ **想真双栈必须起两路 PDN**，
#         见 README「多路 PDN」章 / 140-dualstack.sh（mux129=v4、mux130=v6）。）
#   ⇒ 默认取 `ipv4`（保底：单路 v4 已端到端验证稳定）；
#     要 v6 单栈就设 `ipfam=ipv6`；要双栈用 140 方案（多路 PDN）。
#   ⚠️ 历史坑：原实现写死 `--ip-family ipv4`，于是 `--get-current-settings`
#      永远回 "ip-family":"ipv4" 且 "ipv6":{}——当时误判为「模组/电信不支持 v6」，
#      实际是我们自己没申请。139 已用 `--ip-family ipv6` 打通 v6 端到端。
IPFAM=${FM160_IPFAM:-ipv4}
# IPv6 默认路由的 metric（★ 必须保持较大值：cellular 不得抢走 eth0 的默认路由，
# 本项目曾因 busybox udhcpc 破坏性删默认路由把整机出口切走，见 README §33.4-E）
METRIC=${FM160_METRIC:-11}
TO=${FM160_TIMEOUT:-12000}
# QMAP 聚合参数：必须与驱动 qmi_wwan_f 的 qmap_size 自洽
#   （驱动 bind 时按 speed>=SUPER 取 rx_urb_size=16384=qmap_size，见 qmi_wwan_f.c）
ULMAX=${FM160_ULMAX:-11}
ULSIZE=${FM160_ULSIZE:-8192}
DLMAX=${FM160_DLMAX:-32}
DLSIZE=${FM160_DLSIZE:-16384}
# ★ 冷启动时模组的 QMI 服务要等很久才可用（实测 host reboot 后约 150–200 s）
WAITSEC=${FM160_WAIT:-240}
HEALTH=${FM160_HEALTH:-15}
# ★ netifd/udhcpc 拿 lease 的最长等待（真机实测本模组应答 DHCP，但要 20–60 s）
DHCPWAIT=${FM160_DHCPWAIT:-90}
RUN=/var/run/fm160-qmi
CIDF=$RUN/cid
PDF=$RUN/pdh
LOCK=$RUN/lock
S=/sys/class/net/$IF
# wait_qmi 探测用的 WDS client id（★ 全局声明：脚本开了 `set -u`，
# 函数里直接引用未赋值变量会报 "parameter not set"）
CID_PROBE=""

log() { echo "[$(date '+%H:%M:%S')] $*"; logger -t fm160-qmi "$*" 2>/dev/null; }

mkdir -p "$RUN"

# ── 单实例锁 ────────────────────────────────────────────────────────────────
# ★ 绝不用 `pgrep -x <脚本名>` 认自己：BusyBox 会把
#   `/bin/sh /etc/rc.common <svc> start` 的 comm 报成脚本 basename，
#   导致 init 的 kill 打中自己（本项目已踩过一次，见存档 §0-5）。
#   用 PID 文件 + kill -0 存活校验。
holding() { [ -s "$LOCK" ] && kill -0 "$(cat "$LOCK" 2>/dev/null)" 2>/dev/null; }

# ── 基础工具 ────────────────────────────────────────────────────────────────
# q <cid> <uqmi args...>：把会话钉在同一个 WDS client 上（uqmi 每次调用会重开设备，
# 不钉住 client 的话 start-network 建的会话在下次调用就找不到了）
q() { _c=$1; shift; uqmi -t "$TO" -d "$D" --set-client-id wds,"$_c" "$@" 2>&1; }

qraw() { uqmi -t "$TO" -d "$D" "$@" 2>&1; }

# ★ QMI 传输层在本驱动（qmi_wwan_f）/ 本模组上是**偶发不稳**的：
#   真机实测同一串命令会随机回 `Request timed out` / `Unknown error` /
#   `Failed to connect to service`，下一次同样的调用又成功。
#   ⇒ 每个关键步骤都必须带重试，否则一次抖动就让整轮拨号失败。
#   qretry <次数> <cid|-> <uqmi args...>   成功则打印应答并返回 0
qretry() {
	_n=$1; shift
	_c=$1; shift
	_i=0
	while [ "$_i" -lt "$_n" ]; do
		if [ "$_c" = "-" ]; then
			_o=$(uqmi -t "$TO" -d "$D" "$@" 2>&1)
		else
			_o=$(uqmi -t "$TO" -d "$D" --set-client-id wds,"$_c" "$@" 2>&1)
		fi
		case "$_o" in
			*"Request timed out"* | *"Unknown error"* | *"Failed to connect to service"* | *"No effect"*)
				_i=$((_i + 1))
				log "    重试 $_i/$_n: $(printf '%s' "$_o" | tr '\n' ' ')"
				sleep 3
				;;
			*)
				printf '%s' "$_o"
				return 0
				;;
		esac
	done
	printf '%s' "$_o"
	return 1
}

have_addr() { [ -n "$(ip -4 -o addr show "$IF" 2>/dev/null | awk '{print $4}')" ]; }
have_addr6() { [ -n "$(ip -6 -o addr show "$IF" 2>/dev/null | grep -v ' fe80::' | awk '{print $4}')" ]; }

# ── 驱动 qmap_mode 守卫 ────────────────────────────────────────────────────
# ★★ 必须以 **qmap_mode=1** 加载驱动。依据（qmi_wwan_f.c:2445-2447）：
#      if (pQmapDev->qmap_mode == 1) pQmapDev->mpQmapNetDev[0] = dev->net;
#   ⇒ mode==1 时 **基网卡 wwan0 就是 mux 0 的数据口**，RX 直接投到 wwan0；
#   ⇒ mode>1 时会额外创建 wwan0.1/wwan0.2，RX 只投到 wwan0.N，
#      而本实现把地址、发送门、健康检查全挂在 wwan0 上 ⇒ **静默失败**。
#
# 真机指纹（2026-09-21，脚本 150/151 实测 mode=2）：dial 一切正常
#   （data-status=connected / 聚合=qmap / 地址与 DNS 都对 / link_state=0x3 / carrier=1），
#   但 ping 100% loss、`rx_bytes` 恒 0、dmesg 无任何报错。
# ⇒ 这个坑必须**主动检测并自愈**，否则表现为「拨号成功但完全不通」。
ensure_qmap_mode() {
	if [ ! -d /sys/module/qmi_wwan_f ]; then
		log "开源驱动 stock qmi_wwan：无 QMAP 概念，跳过 qmap_mode 检查"
		return 0
	fi
	_qm=$(cat /sys/module/qmi_wwan_f/parameters/qmap_mode 2>/dev/null)
	[ "$_qm" = "1" ] && return 0
	log "★ 驱动 qmap_mode=${_qm:-未知}（必须为 1）⇒ 以 qmap_mode=1 重新加载"
	_kof=/lib/modules/$(uname -r)/qmi_wwan_f.ko
	[ -f "$_kof" ] || { log "  找不到 $_kof，无法自愈；请手工 insmod qmap_mode=1"; return 1; }
	for _n in "$IF" "$IF.1" "$IF.2"; do ip link set "$_n" down 2>/dev/null; done
	rmmod qmi_wwan_f 2>/dev/null
	sleep 2
	insmod "$_kof" qmap_mode=1 2>/dev/null
	sleep 6
	# 万一被 mainline qmi_wwan 抢走接口 → 抢回来
	if [ ! -e "/sys/class/net/$IF" ]; then
		_bi=$(ls /sys/bus/usb/drivers/qmi_wwan/ 2>/dev/null | grep ':' | head -1)
		log "  $IF 缺失（被 mainline qmi_wwan 抢了？iface=$_bi）⇒ 抢回"
		[ -n "$_bi" ] && echo -n "$_bi" > /sys/bus/usb/drivers/qmi_wwan/unbind 2>/dev/null
		rmmod qmi_wwan 2>/dev/null
		[ -n "$_bi" ] && echo -n "$_bi" > /sys/bus/usb/drivers/qmi_wwan_f/bind 2>/dev/null
		sleep 5
	fi
	[ "$(cat /sys/module/qmi_wwan_f/parameters/qmap_mode 2>/dev/null)" = "1" ] \
		|| { log "  ★ 自愈失败（qmap_mode 仍非 1）"; return 1; }
	log "  已修正为 qmap_mode=1，数据口=$IF"
	return 0
}

# ── IPv6 落地（★ 必须走 QMI 直取，不能靠 DHCP/RA）──────────────────────────
# 为什么直取：本链路是 QMAP/raw-ip，驱动 qmi_wwan_f 给每个包**伪造一个以太头**
#   （qmi_wwan_f.c:1487-1506 发、1612-1663 收，v4/v6 都按 h_proto 正确填），
#   但**没有任何 DHCPv6 / RA 实体**可问 ⇒ 双栈里的 v6 只能从
#   `--get-current-settings` 的 ipv6 表里读，再自己 `ip -6 addr/route` 落。
# ★ 模组**只在会话申请了 v6 时**才返回 ipv6 表（见 IPFAM 与 do_up 第 4 步）；
#   若读到 `"ipv6":{}`，第一嫌疑永远是「本次会话没申请 v6」，而不是「电信不给」。
#
# JSON 解析：busybox 没有 jq，且 `"ip"` / `"gateway"` / `"dns1"` 这些键在
# ipv4 与 ipv6 两张表里**重名**，所以先按 `"ipv6":{...}` 切出片段再抽键，
# 否则 `sed` 会抓到 ipv4 的值（这是个很容易写出「看起来对」的错误）。
jget() { printf '%s' "$1" | sed -n "s/.*\"$2\":\"\([^\"]*\)\".*/\1/p"; }

# 点分十进制掩码 → 前缀长度（数 1 的个数）。空值按蜂窝点对点常见的 /30 处理。
netmask_to_plen() {
	case "$1" in
		'') echo 30; return ;;
	esac
	printf '%s' "$1" | awk -F. '{n=0; for(i=1;i<=4;i++){v=$i+0; while(v>0){n+=v%2; v=int(v/2)}} print n}'
}

# ── IPv4 兜底（QMI 直取）───────────────────────────────────────────────────
# 只在 netifd/udhcpc 没拿到地址时调用（见 do_up 第 7 步的等待逻辑）。
#
# ★ 实测更新（2026-09-21，5G SA）：**本模组在 QMAP 链路上确实应答 DHCP**
#   （udhcpc 拿到 10.144.241.85/30、netifd 自己写好 default 路由与
#    /tmp/resolv.conf.d/resolv.conf.auto）。但**耗时可能超过 20 s**
#   ⇒ 等待必须足够长，否则会像本轮一样先把一个「读得快但很快过期」的
#   地址塞进去（读到的 10.52.229.50 在 20 s 后已不是会话地址）。
#   历史退化态（同一台机器）：ubus 报 {"up":false,"pending":true}、
#   `udhcpc -t 0` 不死也拿不到 lease ⇒ 那时必须靠本函数兜底。
apply_ipv4_from_qmi() {
	_cid=$(cat "$CIDF" 2>/dev/null)
	[ -n "$_cid" ] || return 1
	_js=$(qretry 3 "$_cid" -s --get-current-settings)
	_v4=$(printf '%s' "$_js" | sed 's/.*"ipv4"://; s/}.*//')
	_ip=$(jget "$_v4" ip)
	[ -n "$_ip" ] || { log "IPv4: ipv4 表为空"; return 1; }
	_plen=$(netmask_to_plen "$(jget "$_v4" subnet)")
	_gw=$(jget "$_v4" gateway)
	_d1=$(jget "$_v4" dns1)
	_d2=$(jget "$_v4" dns2)
	ip -4 addr replace "$_ip/$_plen" dev "$IF" 2>/dev/null \
		|| { log "IPv4: ip -4 addr replace 失败 ($_ip/$_plen)"; return 1; }
	if [ -n "$_gw" ]; then
		# ★ 必须带 metric：否则会顶掉 eth0 的默认路由，把整机出口切到蜂窝
		ip -4 route replace default via "$_gw" dev "$IF" metric "$METRIC" 2>/dev/null
	fi
	# netifd 没接手时，DNS 得自己落（dnsmasq 会读这个目录）
	if [ -n "$_d1" ] && [ -d /tmp/resolv.conf.d ]; then
		{ echo "nameserver $_d1"; [ -n "$_d2" ] && echo "nameserver $_d2"; } \
			> /tmp/resolv.conf.d/fm160-v4 2>/dev/null
	fi
	log "IPv4 已落地(QMI 直取): $_ip/$_plen${_gw:+ gw=$_gw}${_d1:+ dns=$_d1}"
	return 0
}

apply_ipv6_from_qmi() {
	_cid=$(cat "$CIDF" 2>/dev/null)
	[ -n "$_cid" ] || return 1
	# -s = 单行 JSON，便于 sed 切片
	_js=$(qretry 3 "$_cid" -s --get-current-settings)
	case "$_js" in
		*'"ipv6"'*) ;;
		*) log "IPv6: 应答里没有 ipv6 表（$(printf '%s' "$_js" | tr '\n' ' ' | cut -c1-80)）"; return 1 ;;
	esac
	_v6=$(printf '%s' "$_js" | sed 's/.*"ipv6"://; s/}.*//')
	_ip=$(jget "$_v6" ip)
	if [ -z "$_ip" ]; then
		log "IPv6: ipv6 表为空（本次会话未申请 v6；当前 IPFAM=$IPFAM）"
		return 1
	fi
	_plen=$(printf '%s' "$_v6" | sed -n 's/.*"ip-prefix-length":\([0-9]*\).*/\1/p')
	_gw=$(jget "$_v6" gateway)
	_d1=$(jget "$_v6" dns1)
	_d2=$(jget "$_v6" dns2)

	# `replace` 而非 `add`：重复拨号不会堆叠出多个地址
	ip -6 addr replace "$_ip/${_plen:-64}" dev "$IF" 2>/dev/null \
		|| { log "IPv6: ip -6 addr replace 失败 ($_ip/${_plen:-64})"; return 1; }

	if [ -n "$_gw" ]; then
		ip -6 route replace default via "$_gw" dev "$IF" metric "$METRIC" 2>/dev/null
	fi

	# v6 DNS 交给 dnsmasq 读（OpenWrt 约定目录）。目录不存在就只记录。
	if [ -n "$_d1" ]; then
		if [ -d /tmp/resolv.conf.d ]; then
			{ [ -n "$_d1" ] && echo "nameserver $_d1"; [ -n "$_d2" ] && echo "nameserver $_d2"; } \
				> /tmp/resolv.conf.d/fm160-v6 2>/dev/null
		fi
	fi

	log "IPv6 已落地: $_ip/${_plen:-64}${_gw:+ gw=$_gw}${_d1:+ dns=$_d1}"
	return 0
}

# 厂商拨号工具计数 —— ★ 必须走 /proc/*/comm，不能用 `ps w | grep -c <模式>`：
#   ssh 进来的那条 `ash -c '<整段命令>'` 的命令行里就含有模式文本，会**自匹配**成 1。
#   （本项目已因此拿到过一次假阳性，且另一次 pgrep -f 直接把自己的 shell 杀掉。）
vendor_procs() {
	_n=0
	for _c in /proc/[0-9]*/comm; do
		read -r _x < "$_c" 2>/dev/null || continue
		case "$_x" in
			quectel-CM | quectel-CM-M) _n=$((_n + 1)) ;;
		esac
	done
	echo "$_n"
}

# qmi_reader_fds()：谁持有 cdc-wdm（单 reader 设备的占用判据）
qmi_reader_fds() { ls -l /proc/*/fd 2>/dev/null | grep -c "cdc-wdm"; }

# ★ QMI 就绪门：光有设备节点不够 —— 冷启动时 /dev/cdc-wdm0 在 38 s 就出现，
#   但模组的 QMI 服务要 150–200 s 才应答。判据用 uqmi 自己问一次服务表。
# ★★★ QMI 就绪门：必须是**服务级**，且只问 WDS
#
# 真机取证（2026-09-21，两轮独立开机 + 稳态对照；脚本 132/135/136 在设备 /root/）：
#   · /dev/cdc-wdm0 在 uptime ~60s 就出现，但那时 WDS 还取不到 client id；
#   · `--get-versions` 会**遍历各服务版本（含 NAS）**，而 NAS 在开机后约 0–200s
#     内存在**周期性（实测间隔 62.97s / 65.76s）数秒级无响应窗口**
#     ⇒ 用它做就绪门，会在这个窗口里**误判「未就绪」**，白等一轮甚至反复失败；
#   · 反例证据（132/136）：uptime 85–196s 期间 `--get-versions` 报 UNKNOWN 的帧，
#     **同帧** `--get-data-status` 却 20–30ms 返回 ok。
#   ⇒ 判据改成只问 WDS：能拿到合法 client id（非空、非 0）且
#     `--get-data-status` 回可识别 JSON（connected / disconnected）。
#
# ★★ 绝不在循环里反复 `--get-client-id`：每成功一次就**永久占掉一个 client id**
#    （真机实测 1→35 单调泄漏、不复用；`uqmi --sync` 只能部分回收）。
#    所以这里最多分配一次，拿到就写进 $CIDF 供后续复用。
wait_qmi() {
	i=0
	while [ "$i" -lt "$WAITSEC" ]; do
		if [ -c "$D" ] && [ -e "$S/statistics/rx_packets" ]; then
			if [ -z "$CID_PROBE" ]; then
				_o=$(qraw --get-client-id wds)
				case "$_o" in
					'' | *[!0-9]* | 0) _o="" ;;
					*) CID_PROBE="$_o"; echo "$_o" > "$CIDF" ;;
				esac
				if [ -z "$CID_PROBE" ]; then
					sleep 3; i=$((i + 3)); continue
				fi
			fi
			case "$(q "$CID_PROBE" --get-data-status 2>/dev/null)" in
				*'"connected"'* | *'"disconnected"'*)
					log "QMI 就绪 @${i}s（服务级判据：WDS cid=$CID_PROBE 已应答）"
					return 0
					;;
			esac
		fi
		sleep 3; i=$((i + 3))
	done
	return 1
}

# cdc-wdm 是【单 reader】设备：uqmi 与 quectel-CM 不能并存（§34.1）。
release_readers() {
	for n in quectel-CM quectel-CM-M; do
		killall "$n" 2>/dev/null && log "已停掉厂商拨号工具 $n"
	done
	i=0
	while [ "$i" -lt 10 ]; do
		n=$(qmi_reader_fds)
		[ "$n" = "0" ] && return 0
		sleep 1; i=$((i + 1))
	done
	log "警告：仍有 $n 个 fd 持有 cdc-wdm（可能有别的进程在抢）"
	return 0
}

get_cid() {
	# 先复用已缓存的 CID（避免每次都新分配、把模组的 CID 池耗掉）
	_old=$(cat "$CIDF" 2>/dev/null)
	case "$_old" in
		'' | *[!0-9]* | 0) ;;
		*)
			case "$(uqmi -t "$TO" -d "$D" --set-client-id wds,"$_old" --get-data-status 2>&1)" in
				*"Unknown error"* | *"Failed to connect to service"* | *"Request timed out"*) ;;
				*) echo "$_old"; return 0 ;;
			esac
			;;
	esac
	# ★★ 缓存 CID 失效时，**必须先 `--sync` 再重新分配**。
	#   真机依据（2026-09-21，脚本 /root/142-pdn-step.sh）：
	#     模组经过大量会话起停后，`--get-client-id` 会返回一个**语义上已失效**的
	#     client id（实测拿到 14；之后每条 `--set-client-id wds,14` 都报
	#     "Unknown error"，连 `--start-network` 都失败）。
	#     而「`--sync` 释放全部 id → 重新分配」后**同一串命令立刻全部成功**。
	#   ⇒ 只重试 get-client-id 而不 sync，会反复拿到失效值，这是本服务
	#     「偶发拨号失败」的一条真实机制。
	qraw --sync >/dev/null 2>&1
	sleep 1
	_i=0
	while [ "$_i" -lt 5 ]; do
		_o=$(qraw --get-client-id wds)
		# ★ 必须排除 "0"：uqmi 偶发会回 0，而 CID 0 在 QMI 里是保留值，
		#   拿它去 --set-client-id 只会连带坏掉整条链路。
		case "$_o" in
			'' | *[!0-9]* | 0) _i=$((_i + 1)); sleep 2 ;;
			*) echo "$_o"; return 0 ;;
		esac
	done
	log "取 WDS client id 失败: $(printf '%s' "$_o" | tr '\n' ' ')"
	return 1
}

# PDH 是**无符号 32 位**句柄，而 uqmi 打印时按有符号 ⇒ 可能是负数。
# 回传给 `--stop-network` 时必须转回无符号：否则前导 '-' 会被 uqmi 当成选项。
pdh_unsigned() {
	case "$1" in
		-*) echo "$(( $1 + 4294967296 ))" ;;
		*) echo "$1" ;;
	esac
}

# ── 起链路 ──────────────────────────────────────────────────────────────────
do_up() {
	ensure_qmap_mode
	wait_qmi || { log "等不到 QMI 就绪（$D / $IF，${WAITSEC}s 超时）"; return 1; }
	release_readers

	# 0) 幂等守卫：链路已在位且健康 ⇒ 不重建。
	#    背景（2026-09-22 开源栈固件首测）：procd 可能同时拉起第二个 watch 实例
	#    （如网络配置变更触发服务重启），新实例的 do_up 从 ifdown 开始把正在
	#    工作的链路拆掉重拨。这里先体检，健康就直接返回。
	if [ -s "$CIDF" ] && [ -s "$PDF" ]; then
		_oc=$(cat "$CIDF")
		case "$(q "$_oc" --get-data-status 2>/dev/null)" in
			*'"connected"'*)
				if [ "$(cat "$S/carrier" 2>/dev/null)" = "1" ] && have_addr; then
					log "链路已在位（cid=$_oc pdh=$(cat "$PDF")），跳过重建"
					ifup "$NETIF" 2>/dev/null
					return 0
				fi ;;
		esac
	fi

	# 1) WDS client（会话绑在它上面）
	_cid=$(get_cid) || return 1
	echo "$_cid" > "$CIDF"

	# 2) ★★ SET_DATA_FORMAT —— 冷启动**必需**的一步（等价 CM 的 QMIWDS_ADMIN_SET_DATA_FORMAT）
	#
	#    为什么必需：模组复位/冷启动后，模组侧
	#        data-aggregation-protocol = "unknown"，ul/dl max datagrams = 0
	#    ⇒ 模组按「不分帧」发裸 IP，而厂商驱动 qmi_wwan_f 在 bind 时强制 qmap_mode=1
	#      并给每个 TX 包加 QMAP 头（mux_id 0x81）⇒ 期望收到 QMAP 帧。
	#    不匹配的后果（真机实测）：宿主 rx 恒 0，dmesg 刷
	#        "net wwan0: drop skb_len=79eb larger than 1500"   ← 伪随机长度 = 把裸 IP 头当 QMAP 解析
	#    只调 BIND_MUX 不够；必须先把聚合显式设成 qmap。
	#
	#    好消息：uqmi 的 --wda-set-data-format **原生带聚合选项**，无需打补丁。
	#
	#    ★ 聚合选项**只在厂商驱动 qmi_wwan_f 下才能加**（2026-09-22 开源栈首测）：
	#      stock qmi_wwan 没有 QMAP 解封装，若让模组把下行包 QMAP 封装，驱动
	#      原样上交 ⇒ 内核收到带 12 字节 QMAP 头的垃圾帧，DHCP 永远无应答；
	#      且真机实测 QMI 服务会在持续无效下行流量中崩溃。stock 驱动下只设裸
	#      raw-ip（不加任何聚合字段）。
	if [ -d /sys/module/qmi_wwan_f ]; then
		_n=$(qretry 5 - --wda-set-data-format raw-ip \
			--ul-aggregation-protocol qmap --dl-aggregation-protocol qmap \
			--ul-datagram-max-count "$ULMAX" --ul-datagram-max-size "$ULSIZE" \
			--dl-datagram-max-count "$DLMAX" --dl-datagram-max-size "$DLSIZE")
		_fmtdesc="raw-ip + ul/dl=qmap, $ULMAX/$ULSIZE, $DLMAX/$DLSIZE"
	else
		_n=$(qretry 5 - --wda-set-data-format raw-ip)
		_fmtdesc="raw-ip（stock qmi_wwan，无聚合）"
	fi
	case "$_n" in
		*error* | *Error* | *ERROR* | *timed* | *not* | *failed*)
			log "SET_DATA_FORMAT 异常（已重试）: $(printf '%s' "$_n" | tr '\n' ' ')" ;;
		*)
			log "SET_DATA_FORMAT ok ($_fmtdesc)" ;;
	esac
	sleep 1

	# 3) bind mux —— 等价 CM 的 QMIWDS_BIND_MUX_DATA_PORT（TLV 逐字段相同）
	_b=$(qretry 5 "$_cid" --bind-mux "$MUX" --endpoint-type "$EPE" --endpoint-iface "$EPI")
	[ -n "$_b" ] && log "bind-mux(mux=$MUX ep=$EPE/$EPI): $(printf '%s' "$_b" | tr '\n' ' ')"
	sleep 1

	# 4) start network —— 等价 CM 的 QMIWDS_START_NETWORK_INTERFACE
	if [ -n "$APN" ]; then
		_sn=$(qretry 5 "$_cid" --start-network --apn "$APN" --ip-family "$IPFAM")
	else
		# --profile <index> = 用模组自带 profile（CM 的 requestGetProfile[pdp:1 index:1]）
		_sn=$(qretry 3 "$_cid" --start-network --profile "$PROFILE" --ip-family "$IPFAM")
		# 判据同样要用「有符号整数」（PDH 可能是负数）
		if ! printf '%s\n' "$_sn" | grep -qE '^-?[0-9]+$'; then
			log "--profile $PROFILE 未回 PDH（$(printf '%s' "$_sn" | tr '\n' ' ')），回退 --apn ctnet"
			_sn=$(qretry 5 "$_cid" --start-network --apn ctnet --ip-family "$IPFAM")
		fi
	fi
	# ★ uqmi 的 start-network 打印【裸数字】= WDS Packet Data Handle。
	#   它是 32 位**不透明句柄**，uqmi 按**有符号**打印 ⇒ **可能是负数**！
	#   真机实测：1264116928（正）、844793808（正）、-1740523296（负，= 0x9820_6A20）。
	#   ⇒ 正则必须写成 `-?[0-9]+`。写成 `^[0-9]+$` 会把负句柄当成失败，
	#     进而错误回退到 --apn，报一串 "No effect"（本项目踩过，见存档 §35）。
	#   也绝不要去匹配 `"pdh":` 标签 —— uqmi 这条命令根本不输出 JSON 标签。
	_pdh=$(printf '%s\n' "$_sn" | grep -E '^-?[0-9]+$' | tail -1)
	if [ -z "$_pdh" ]; then
		# 「No effect」= 该 client 上已有活跃会话（如前一个实例没来得及停链路
		# 就被 kill）。此时不判失败——收养现有会话，继续走 5)–7) 拿地址。
		case "$_sn" in
			*'No effect'*)
				log "start-network: No effect（会话已存在）⇒ 收养现有会话继续"
				_pdh="existing" ;;
			*)
				log "start-network 失败: $(printf '%s' "$_sn" | tr '\n' ' ')"
				return 1 ;;
		esac
	fi
	echo "$_pdh" > "$PDF"
	log "start-network ok, pdh=$_pdh"

	# 5) data status（判据：必须 connected）
	_ds=$(qretry 5 "$_cid" --get-data-status)
	case "$_ds" in
		*'"connected"'*) log "data status: connected" ;;
		*) log "data status 不是 connected: $(printf '%s' "$_ds" | tr '\n' ' ')"; return 1 ;;
	esac

	# 6) 抬厂商驱动的发送门（qmap_mode && !link_state ⇒ drop skb，见 qmi_wwan_f.c）
	echo 1 > "$S/link_state" 2>/dev/null
	ip link set "$IF" up 2>/dev/null
	sleep 1

	# 7) 地址交给 netifd（开源 udhcpc + /lib/netifd/dhcp.script）
	#
	# ★★ 等待时长很关键（2026-09-21 真机教训）：本模组**会**应答 DHCP，但拿到
	#    lease 可能要 20–60 s。等待太短（初版 20 s）会让 QMI 兜底先塞进一个
	#    「此刻读得到、但会话随后已换」的地址，表现为 wwan0 上出现两个 /30 地址、
	#    ping 仍通但源地址选错。⇒ 默认等 $DHCPWAIT=90 s，且判据用 netifd 状态。
	ifup "$NETIF" 2>/dev/null

	i=0
	while [ "$i" -lt "$DHCPWAIT" ]; do
		case "$(ubus call network.interface."$NETIF" status 2>/dev/null)" in
			*'"ipv4-address"'*) break ;;	# netifd 自己拿到地址了
		esac
		have_addr && break
		sleep 2; i=$((i + 2))
	done

	# 7b) QMI 兜底：netifd 确实没拿到 v4 时才用（退化态的唯一出路）
	#
	# ★★ 必须先 `ifdown`！netifd 在接口处于 `pending` 时会**持续维护**该设备的
	#    地址/路由，把我们手工加上的地址**冲掉**（真机实测：apply 报成功、
	#    下一句 have_addr 就为空，`2_1` 仍显示 {"up":false,"pending":true}）。
	#    先把 netifd 的手拿开，再自己落地。
	if ! have_addr; then
		log "netifd 等待 ${DHCPWAIT}s 仍未取到 IPv4 ⇒ 改用 QMI 直取兜底"
		ifdown "$NETIF" >/dev/null 2>&1
		sleep 2
		apply_ipv4_from_qmi
		# 地址落地后再核一次（netifd/内核残余动作可能又把它清掉）
		_k=0
		while [ "$_k" -lt 3 ] && ! have_addr; do
			sleep 2
			apply_ipv4_from_qmi
			_k=$((_k + 1))
		done
	else
		# netifd 成功时它自己已经写好地址/默认路由/DNS，这里只做确认
		case "$(ubus call network.interface."$NETIF" status 2>/dev/null)" in
			*'"ipv4-address"'*) log "IPv4 由 netifd(udhcpc) 落地" ;;
			*) log "IPv4 由 QMI 直取落地" ;;
		esac
	fi

	# 7c) IPv6（★ 只能走 QMI 直取：本链路没有 DHCPv6/RA 实体）
	apply_ipv6_from_qmi

	if have_addr; then
		log "IPv4 已就绪: $(ip -4 -o addr show "$IF" | awk '{print $4}' | tr '\n' ' ')"
	else
		log "★ 未取到 IPv4（operstate=$(cat $S/operstate 2>/dev/null) carrier=$(cat $S/carrier 2>/dev/null)）"
	fi
	if have_addr6; then
		log "IPv6 已就绪: $(ip -6 -o addr show "$IF" | grep -v ' fe80::' | awk '{print $4}' | tr '\n' ' ')"
	else
		log "IPv6: 未落地（IPFAM=$IPFAM）"
	fi
	have_addr || return 1
	return 0
}

# ── 停链路 ──────────────────────────────────────────────────────────────────
do_down() {
	_cid=$(cat "$CIDF" 2>/dev/null)
	_pdh=$(cat "$PDF" 2>/dev/null)
	if [ -n "$_cid" ] && [ -n "$_pdh" ]; then
		_o=$(q "$_cid" --stop-network "$(pdh_unsigned "$_pdh")")
		[ -n "$_o" ] && log "stop-network: $(printf '%s' "$_o" | tr '\n' ' ')"
	fi
	ifdown "$NETIF" 2>/dev/null
	echo 0 > "$S/link_state" 2>/dev/null
	ip -4 addr flush dev "$IF" 2>/dev/null
	ip -6 addr flush dev "$IF" scope global 2>/dev/null
	ip -6 route del default dev "$IF" 2>/dev/null
	rm -f /tmp/resolv.conf.d/fm160-v6
	rm -f "$CIDF" "$PDF"
	log "已停链路"
}

# ── 状态 ────────────────────────────────────────────────────────────────────
do_status() {
	_cid=$(cat "$CIDF" 2>/dev/null)
	echo "== fm160-qmi status =="
	echo "  wdm=$D if=$IF netif=$NETIF mux=$MUX (profile=$PROFILE ipfam=$IPFAM${APN:+ apn=$APN})"
	echo "  cid=${_cid:-（无）} pdh=$(cat "$PDF" 2>/dev/null || echo '（无）')"
	echo "  link_state=$(cat "$S/link_state" 2>/dev/null) carrier=$(cat "$S/carrier" 2>/dev/null) operstate=$(cat "$S/operstate" 2>/dev/null)"
	echo "  qmap_mode=$(cat /sys/module/qmi_wwan_f/parameters/qmap_mode 2>/dev/null)（必须为 1；>1 ⇒ 数据口变 $IF.1，本实现会静默不通）"
	echo "  addr4=$(ip -4 -o addr show "$IF" 2>/dev/null | awk '{print $4}' | tr '\n' ' ')"
	echo "  addr6=$(ip -6 -o addr show "$IF" 2>/dev/null | grep -v ' fe80::' | awk '{print $4}' | tr '\n' ' ')"
	echo "  rx=$(cat "$S/statistics/rx_packets" 2>/dev/null)/$(cat "$S/statistics/rx_bytes" 2>/dev/null)B tx=$(cat "$S/statistics/tx_packets" 2>/dev/null)/$(cat "$S/statistics/tx_bytes" 2>/dev/null)B"
	[ -n "$_cid" ] && echo "  data-status=$(qretry 3 "$_cid" --get-data-status | tr -d '\n')"
	# ★ 排查 IPv6 缺口的**第一判据**：这里若出现 "ip-family":"ipv4" 或 "ipv6":{}，
	#   说明本次会话压根没申请 v6（对照上面的 ipfam），而不是网络不支持。
	#   ⚠️ 必须带 cid：不带 --set-client-id 时 uqmi 会另起一个 client，
	#      读到的是**别的**会话（本项目踩过——status 里这一行曾是空的）。
	[ -n "$_cid" ] && echo "  current-settings: $(qretry 3 "$_cid" -s --get-current-settings 2>/dev/null | grep -o '"pdp-type":"[^"]*"\|"ip-family":"[^"]*"' | tr '\n' ' ')"
	echo "  --- data format（此处只读；写只发生在 do_up 的 SET_DATA_FORMAT 一步）---"
	qraw --wda-get-data-format | sed 's/^/    /'
	echo "  --- 默认路由 ---"
	ip route show | grep -E '^default' | sed 's/^/    /'
	echo "  --- 厂商工具是否在跑（应为 0）---"
	echo "    quectel-CM 进程数: $(vendor_procs)"
}

# ── 健康检查 ────────────────────────────────────────────────────────────────
healthy() {
	_cid=$(cat "$CIDF" 2>/dev/null)
	[ -n "$_cid" ] || return 1
	case "$(q "$_cid" --get-data-status)" in
		*'"connected"'*) ;;
		*) return 1 ;;
	esac
	[ "$(cat "$S/carrier" 2>/dev/null)" = "1" ] || return 1
	have_addr || return 1
	return 0
}

# ── 守护模式（procd 调用）──────────────────────────────────────────────────
do_watch() {
	_fail=0
	log "进入守护模式（每 ${HEALTH}s 健康检查）"
	do_up || log "首次起链路未完成，进入重试"
	# DHCP 获取宽限：模组应答 DHCP 要 20–60s（见 do_up 第 7 步注释），
	# 而健康检查 3×${HEALTH}s 就会触发拆链重拨——宽限期内失败不计数，
	# 否则每次都把刚到手的 lease 掐死在摇篮里（2026-09-22 开源栈首测实测）。
	_grace=$(( $(date +%s) + DHCPWAIT ))
	while :; do
		sleep "$HEALTH"
		if healthy; then
			_fail=0
		else
			if [ "$(date +%s)" -lt "$_grace" ]; then
				continue
			fi
			_fail=$((_fail + 1))
			log "健康检查失败 $_fail/3"
			if [ "$_fail" -ge 3 ]; then
				log "连续 3 次失败 ⇒ 重新拨号"
				do_down
				sleep 2
				do_up
				_fail=0
				_grace=$(( $(date +%s) + DHCPWAIT ))
			fi
		fi
	done
}

# ── 入口 ────────────────────────────────────────────────────────────────────
CMD=${1:-status}
case "$CMD" in
	up)
		if ! mkdir /tmp/fm160-qmi.uplock 2>/dev/null; then
			log "已有实例在跑，跳过"
			exit 0
		fi
		trap 'rmdir /tmp/fm160-qmi.uplock' EXIT INT TERM
		do_up
		;;
	down)
		do_down
		;;
	status)
		do_status
		;;
	watch)
		# mkdir 原子锁：文件锁存在“读后写入”竞态，两个实例会互相覆盖共存
		if ! mkdir /tmp/fm160-qmi.watchlock 2>/dev/null; then
			log "已有守护实例在跑，退出"
			exit 0
		fi
		trap 'rmdir /tmp/fm160-qmi.watchlock' EXIT INT TERM
		do_watch
		;;
	*)
		echo "用法: $0 {up|down|status|watch}"
		exit 2
		;;
esac
