#!/bin/sh /etc/rc.common
# /etc/init.d/fm160-qmi —— FM160 开源 QMI 拨号服务（procd 托管）
#
# 依赖：uqmi（OpenWrt 自带）、network.2_1（proto=dhcp / device=wwan0 / metric=11，本机已存在）
# 与 fm160d 的关系：fm160d 只管 AT 侧（模块识别、band lock、cell lock、GNSS 配置），
#                  不持有 /dev/cdc-wdm0，因此**可以并存**。
#
# 开关：/etc/config/fm160-qmi   option enabled '1' / '0'      （默认 1）
#       /etc/config/fm160-qmi   option apn  'ctnet'           （留空则用模组 profile 1）

START=98
STOP=10
USE_PROCD=1

. /lib/functions.sh

svc_config() {
	config_load fm160-qmi
	config_get FM160_ENABLED main enabled 1
	config_get FM160_APN_CFG main apn ""
	config_get FM160_PROFILE_CFG main profile "1"
	config_get FM160_NETIF_CFG main netif "2_1"
	# ipv4 | ipv6   （默认 ipv4：单路 v4 已端到端验证）
	# ★★ `unspecified` **不要用作默认**：137/137b 真机四变体实测，模组在
	#    「不传/传 unspecified」时回的是 **v6-only**（不是双栈），会得到一个
	#    只有 v6、没有 v4 的链路。双栈必须靠两路 PDN（见 README「多路 PDN」章）。
	config_get FM160_IPFAM_CFG main ipfam "ipv4"
	# IPv4/IPv6 默认路由 metric（保持较大值，别抢 eth0 的默认路由）
	config_get FM160_METRIC_CFG main metric "11"
	# netifd/udhcpc 拿 lease 的最长等待（秒）。本模组会应答 DHCP 但要 20–60 s。
	config_get FM160_DHCPWAIT_CFG main dhcpwait "90"
}

start_service() {
	svc_config
	if [ "$FM160_ENABLED" = "0" ]; then
		logger -t fm160-qmi "disabled by /etc/config/fm160-qmi"
		return 0
	fi

	procd_open_instance
	procd_set_param command /usr/sbin/fm160-qmi watch
	procd_set_param env \
		FM160_APN="$FM160_APN_CFG" \
		FM160_PROFILE="$FM160_PROFILE_CFG" \
		FM160_NETIF="$FM160_NETIF_CFG" \
		FM160_IPFAM="$FM160_IPFAM_CFG" \
		FM160_METRIC="$FM160_METRIC_CFG" \
		FM160_DHCPWAIT="$FM160_DHCPWAIT_CFG"
	# 崩了就拉起来（阈值 3600s/5s/5s）
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	/usr/sbin/fm160-qmi down
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger fm160-qmi
}
