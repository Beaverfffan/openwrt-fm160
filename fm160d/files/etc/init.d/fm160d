#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later

# Start after ubus-at-daemon (START=98) so the transport is already up.
START=99
STOP=12

USE_PROCD=1
PROG=/usr/sbin/fm160d

start_service() {
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# Best effort: leave the modem in a usable state rather than mid-transaction.
	logger -t fm160d "stopping"
}

service_triggers() {
	procd_add_reload_trigger "fm160"
}
