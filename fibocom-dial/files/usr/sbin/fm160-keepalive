#!/bin/sh
# fm160-keepalive - dial keepalive for the three FM160 dial paths.
#
# After the link comes up, every ka_interval seconds one round pings the
# module-reported DNS (v4 and/or v6, honouring dial_v4/dial_v6) through the
# carrier path:
#
#   round OK            -> counters reset
#   round fail          -> redial (ifdown + fm160-dial-ctl up)
#   ka_reload_rounds consecutive fails
#                       -> module reload (USB profile bounce) + redial
#   ka_stop_rounds rounds inside a 24 h sliding window
#                       -> give up: log, mark stopped, exit
#
# DNS defaults to what netifd reports for network.fm160 (all three protos
# push the module's DNS servers).  ka_dns4/ka_dns6 override per family.
#
# Usage:
#   fm160-keepalive run [4|6]  daemon loop (started via setsid by dial-ctl up);
#                              optional family arg runs a split watchdog that
#                              only checks v4 or only v6 (ka_split=1)
#   fm160-keepalive start      start daemon(s) if not already running
#   fm160-keepalive stop       stop daemon(s)
#   fm160-keepalive status     JSON snapshot (settings + counters)
#
# State lives in /var/run (tmpfs): counters intentionally reset on reboot,
# which also restarts the 24 h window.

CFG=fm160
BASE=/var/run/fm160-keepalive
CTL=/usr/sbin/fm160-dial-ctl
# FAM: empty = one daemon checks every enabled family; 4|6 = split daemon
# (ka_split=1) that watches a single family with its own state/counters.
FAM=
STATE=$BASE.state
PIDFILE=$BASE.pid
CTL=/usr/sbin/fm160-dial-ctl

log() { logger -t fm160-keepalive "$*"; }
op()  { /usr/sbin/fm160-oplog add keepalive "$1" "$2" "$3" 2>/dev/null; }

ucig() { uci -q get "$CFG".main."$1"; }

ka_enable()  { local v; v=$(ucig ka_enable); echo "${v:-1}"; }
ka_interval(){ ucig ka_interval || echo 30; }
ka_reload()  { ucig ka_reload_rounds || echo 5; }
ka_stop()    { ucig ka_stop_rounds || echo 10; }
ka_dns4()    { ucig ka_dns4; }
ka_dns6()    { ucig ka_dns6; }
ka_dns4_2()  { ucig ka_dns4_2; }
ka_dns6_2()  { ucig ka_dns6_2; }
ka_split()   { ucig ka_split || echo 0; }
dial_v4()    { ucig dial_v4 || echo 1; }
dial_v6()    { ucig dial_v6 || echo 1; }

# Split daemon interval: the v6 watchdog runs at half frequency by default
# (ka_interval x 2), overridable via ka_interval6.
fam_interval() {
	local v
	if [ "$FAM" = 6 ]; then
		v=$(ucig ka_interval6)
		if [ -n "$v" ]; then echo "$v"; else echo $(( $(ka_interval) * 2 )); fi
	else
		ka_interval
	fi
}

usbmode_for() { case "$1" in ecm) echo 33;; qmap) echo 32;; *) echo 30;; esac; }

# ── modesw (USB profile switch) state machine ──────────────────────────────
# fm160d drives every profile change through a state machine; the status
# snapshot exposes it as modesw.{state_raw,current,target,last_error}:
#   state_raw: 0=idle  1=reading profile list  2=applying  3=verifying  4=stuck
# A setusbmode reply only means the WRITE was accepted — the module then
# re-enumerates, which takes 30-90 s.  So: never sleep a fixed number and
# assume; poll the machine until it actually settles at the target profile.
msw_snapshot() { ubus call fm160 status 2>/dev/null; }

# wait_modesw <target|empty> <timeout_s> -> 0 settled (idle, at target if
# given), 1 timeout or stuck.  One ubus read per poll, filtered twice —
# `read a b` would split ONE line across vars and drop the second line.
wait_modesw() {
	local target=$1 timeout=$2 elapsed=0 snap st cur
	while [ "$elapsed" -lt "$timeout" ]; do
		snap=$(msw_snapshot)
		st=$(echo "$snap" | jsonfilter -e '@.modesw.state_raw' 2>/dev/null)
		cur=$(echo "$snap" | jsonfilter -e '@.modesw.current' 2>/dev/null)
		if [ "$st" = "4" ]; then
			log "modesw stuck (want $target): $(echo "$snap" | jsonfilter -e '@.modesw.last_error' 2>/dev/null)"
			return 1
		fi
		if [ "$st" = "0" ]; then
			if [ -z "$target" ] || [ "$cur" = "$target" ]; then
				return 0
			fi
		fi
		sleep 3; elapsed=$((elapsed + 3))
	done
	log "modesw settle${target:+ to $target} timed out after ${timeout}s (state=${st:-?} current=${cur:-?})"
	return 1
}

# request_mode <mode> -> echoes the reply result (applying|already|refused|
# busy|not-ready|error).  Retries once after the machine goes idle when the
# refusal was a transient gate (busy / not-ready) rather than a real refusal.
request_mode() {
	local mode=$1 r=error i
	for i in 1 2; do
		r=$(ubus call fm160 setusbmode "{\"mode\":$mode}" 2>/dev/null \
			| jsonfilter -e '@.result' 2>/dev/null)
		[ -n "$r" ] || r=error
		case "$r" in
			applying|already) echo "$r"; return 0 ;;
		esac
		log "setusbmode $mode -> $r (attempt $i, detail: $(msw_snapshot | jsonfilter -e '@.modesw.last_error' 2>/dev/null))"
		[ "$i" = 1 ] && wait_modesw "" 45
	done
	echo "$r"
	[ "$r" = already ]
}

# ── state file ─────────────────────────────────────────────────────────────
state_write() {
	# $1=state $2=last_check $3=last_targets
	cat > "$STATE" <<EOF
state=$1
last_check=$2
# quoted: targets now carry a space (primary + backup) and the state file
# is re-sourced by status() — an unquoted value would execute as a command
last_targets="$3"
consec_fail=$CONSEC
window_start=$WSTART
window_rounds=$WCOUNT
reloads=$RELOADS
total_rounds=$TOTAL
last_reload=${LAST_RELOAD:-}
last_reload_at=${LAST_RELOAD_AT:-0}
last_change=$(date +%s)
EOF
}

# ── link facts ─────────────────────────────────────────────────────────────
ifstatus()  { ubus call network.interface.fm160 status 2>/dev/null; }
link_up()   { [ "$(ifstatus | jsonfilter -e '@.up' 2>/dev/null)" = "true" ]; }

# DNS reported by the module via netifd, split per family.  Echoes one per
# line; empty when the family has no server (caller falls back).
dns_from_netif() {
	ifstatus | jsonfilter -e '@["dns-server"][@]' 2>/dev/null
}

has_addr4() { [ -n "$(ifstatus | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)" ]; }
has_addr6() { [ -n "$(ifstatus | jsonfilter -e '@["ipv6-address"][0].address' 2>/dev/null)" ]; }

# ── ping ───────────────────────────────────────────────────────────────────
# per-target timeout 8 s (was 4): carrier RTT jitter was trimming real links.
ping4() { ping -c 1 -W 8 "$1" >/dev/null 2>&1; }
ping6() { ping -6 -c 1 -W 8 "$1" >/dev/null 2>&1; }

# Two targets per family: primary = user override, else module-reported DNS;
# secondary = second override, else AliDNS (223.5.5.5 / 2400:3200::1).  When
# the module reports nothing the primary falls back to Ali and the secondary
# to the second Ali anycast (223.6.6.6 / 2400:3200:baba::1).  A family counts
# as OK when ANY of its targets answers — a round only fails when every
# target of the family has timed out.
targets4() {
	local t1= t2=
	t1=$(ka_dns4); [ -z "$t1" ] && t1=$(dns_from_netif | grep -m1 '\.')
	t2=$(ka_dns4_2); [ -z "$t2" ] && t2=223.5.5.5
	if [ -z "$t1" ]; then t1=$t2; t2=223.6.6.6; fi
	[ "$t1" = "$t2" ] && t2=
	echo "$t1 $t2" | sed 's/ $//'
}
targets6() {
	local t1= t2=
	t1=$(ka_dns6); [ -z "$t1" ] && t1=$(dns_from_netif | grep -m1 ':')
	t2=$(ka_dns6_2); [ -z "$t2" ] && t2=2400:3200::1
	if [ -z "$t1" ]; then t1=$t2; t2=2400:3200:baba::1; fi
	[ "$t1" = "$t2" ] && t2=
	echo "$t1 $t2" | sed 's/ $//'
}

# ── module reload: bounce the USB profile to the other mode and back ───────
# Proven recovery for a wedged module endpoint (see notes §23 坑1): a plain
# redial is not enough once the modem side stops answering.
# SIGKILL udhcpc orphans: any usb0 udhcpc reparented to init (ppid 1) is a
# leftover from an earlier dial attempt whose ecm-dhcp.sh parent a teardown
# already reaped — nothing else will ever clean it (seen: 10 piled up after
# a keepalive storm).  Must be SIGKILL, not TERM: a graceful udhcpc runs
# the deconfig script on exit and pushes a zero-address update into netifd,
# wiping the lease the live client just obtained.
clean_orphan_dhcp() {
	local p
	for p in $(pgrep -f "udhcpc .*-i usb0" 2>/dev/null); do
		[ "$(cat /proc/$p/comm 2>/dev/null)" = udhcpc ] || continue
		[ "$(awk '{print $4}' /proc/$p/stat 2>/dev/null)" = 1 ] && kill -9 "$p" 2>/dev/null
	done
}

# After ifdown, every surviving usb0 udhcpc is an orphan by definition (the
# legit client belongs to the proto tree the teardown just reaped), so a
# full sweep there is safe — unlike mid-attempt, where the live one must be
# spared (and ppid cannot tell them apart: the about-to-be-orphaned client
# still points at its doomed parent when the sweep would run).
sweep_dhcp() {
	local p
	for p in $(pgrep -f "udhcpc .*-i usb0" 2>/dev/null); do
		[ "$(cat /proc/$p/comm 2>/dev/null)" = udhcpc ] && kill -9 "$p" 2>/dev/null
	done
}

reload_modem() {
	local want other live r1 r2 ok
	# Prefer the mode the module is ACTUALLY in (ubus), not the config:
	# dial_mode is only written after a LuCI mode switch, so a fresh
	# config misleads this bounce — 2026-09-23 incident: an ECM box
	# defaulted to mbim here, bounced 30->32->30, and the dial never
	# came back until the mode was restored by hand.
	live=$(msw_snapshot | jsonfilter -e '@.usb_mode' 2>/dev/null)
	case "$live" in
		33|32|30) want=$live ;;
		*)	want=$(usbmode_for "$(ucig dial_mode || echo ecm)") ;;
	esac
	case "$want" in
		33) other=30 ;;
		32) other=30 ;;
		*)  other=32 ;;
	esac
	log "module reload: bounce usb mode $want -> $other -> $want"
	# Take the interface DOWN before the bounce, not after: if it is
	# still up when usb0 re-appears, netifd respawns the DHCP client on
	# its own and a later teardown orphans it (2026-09-23: one orphan
	# survived every sweep this way).  Down first -> the whole post-
	# bounce DHCP lifecycle belongs to the single ctl up below.
	ifdown fm160 2>/dev/null || ubus call network.interface.fm160 down >/dev/null 2>&1
	sleep 2
	sweep_dhcp
	clean_orphan_dhcp

	# Phase 1: drop to the other profile and let the data path fully
	# reset.  A too-quick bounce back is a no-op reset — the module never
	# notices — so dwell a few seconds in the other profile by design.
	r1=$(request_mode "$other")
	if [ "$r1" != already ]; then
		wait_modesw "$other" 60 || log "phase 1 settle incomplete, continuing anyway"
		sleep 5
	fi

	# Phase 2: back to the working profile, verified via the state
	# machine (not a blind sleep).  ctl up's ensure_usb_mode re-checks
	# the profile too, so a false "ok" here still cannot misdial.
	r2=$(request_mode "$want")
	ok=0
	if [ "$r2" = already ]; then
		ok=1
	elif wait_modesw "$want" 120; then
		ok=1
	fi
	# The bounce tore the data path down underneath every usb0 udhcpc:
	# the pre-bounce clients are all reparented orphans now and the new
	# dial has not started yet, so a full sweep here cannot hit anyone
	# legitimate (same reasoning as sweep_dhcp after ifdown).
	sweep_dhcp
	LAST_RELOAD=$ok; LAST_RELOAD_AT=$(date +%s)
	if [ "$ok" = 1 ]; then
		log "module reload done: settled at mode $want (r1=$r1 r2=$r2)"
		op 模块重载 "USB 弹跳 $want→$other→$want，状态机确认回到 $want" 成功
	else
		log "module reload UNCONFIRMED (r1=$r1 r2=$r2, error: $(msw_snapshot | jsonfilter -e '@.modesw.last_error' 2>/dev/null))"
		op 模块重载 "USB 弹跳 $want→$other→$want 未确认 settled（r1=$r1 r2=$r2）" 异常
	fi
	"$CTL" up >/dev/null 2>&1
}

redial() {
	log "redial: ifdown fm160, then ctl up"
	ifdown fm160 2>/dev/null || ubus call network.interface.fm160 down >/dev/null 2>&1
	sleep 2
	sweep_dhcp
	sleep 3
	"$CTL" up >/dev/null 2>&1
}

# ── one check round ────────────────────────────────────────────────────────
# A split daemon (FAM=4|6) checks only its own family; the combined daemon
# checks every family the dial stack enables.  Within a family ALL targets
# must time out to fail it; the round fails when a checked family fails (or
# the link is not up at all).  Return codes:
#   0  every checked family had at least one target answering
#   1  at least one checked family had ALL its targets time out
#   2  nothing to check yet (link up but no address configured) — neutral
check_round() {
	local fams="" fam targets t ok desc="" checkable=0

	# 接口没起 = 失败（触发重拨），不能只跳过 —— 否则 setup 挂死会被掩盖
	link_up || { TARGETS="link-down"; return 1; }

	if [ -n "$FAM" ]; then
		fams=$FAM
	else
		[ "$(dial_v4)" = 1 ] && fams="4"
		[ "$(dial_v6)" = 1 ] && fams="$fams 6"
	fi

	for fam in $fams; do
		if [ "$fam" = 4 ]; then
			has_addr4 || continue
			targets=$(targets4)
		else
			has_addr6 || continue
			targets=$(targets6)
		fi
		checkable=1
		ok=0
		for t in $targets; do
			if [ "$fam" = 4 ]; then ping4 "$t"; else ping6 "$t"; fi && ok=1
			[ "$ok" = 1 ] && break
		done
		[ -n "$desc" ] && desc="$desc "
		desc="${desc}v${fam}=$targets"
		[ "$ok" = 1 ] || { TARGETS=$desc; return 1; }
	done
	TARGETS=$desc
	[ "$checkable" = 0 ] && return 2
	return 0
}

# ── daemon ─────────────────────────────────────────────────────────────────
run() {
	local now
	echo $$ > "$PIDFILE"
	trap 'rm -f "$PIDFILE" "$STATE"; exit 0' TERM INT

	CONSEC=0; WSTART=$(date +%s); WCOUNT=0; RELOADS=0; TOTAL=0; TARGETS=""
	LAST_RELOAD=; LAST_RELOAD_AT=0
	state_write running wait ""
	log "started (family=${FAM:-both} interval=$(fam_interval)s reload=$(ka_reload) stop=$(ka_stop))"

	# wait for the link before the first round; bail out on disable
	while ! link_up; do
		[ "$(ka_enable)" = 0 ] && { state_write disabled wait ""; exit 0; }
		sleep 5
	done
	log "link up, keepalive active"
	op 保活启动 "巡检间隔=$(ka_interval)s 重载阈值=$(ka_reload) 放弃阈值=$(ka_stop)" 运行中

	# 重拨/重载后的宽限期：拨号要 20-90s，期间不算失败
	GRACE_UNTIL=0

	while :; do
		sleep "$(fam_interval)" 2>/dev/null || exit 0
		[ "$(ka_enable)" = 0 ] && { log "disabled by config"; state_write disabled wait ""; exit 0; }

		now=$(date +%s)
		if [ "$now" -lt "$GRACE_UNTIL" ]; then
			state_write running waiting "$TARGETS"
			continue
		fi

		check_round
		case $? in
		 2)
			# 链路起但地址未就位（拨号刚完成）：中性跳过
			state_write running wait "$TARGETS"
			continue ;;
		 0)
			if [ "$CONSEC" != 0 ] || [ "$WCOUNT" != 0 ]; then
				log "round ok (targets: $TARGETS), counters reset"
			fi
			CONSEC=0
			state_write running ok "$TARGETS"
			continue ;;
		esac

		CONSEC=$((CONSEC + 1)); TOTAL=$((TOTAL + 1))
		if [ $((now - WSTART)) -gt 86400 ]; then
			WSTART=$now; WCOUNT=0
		fi
		WCOUNT=$((WCOUNT + 1))
		log "round FAIL $CONSEC consecutive (24h window $WCOUNT/$(ka_stop)) targets: $TARGETS"
		op 保活检查失败 "第 $CONSEC 次连续失败（24h 窗口 $WCOUNT/$(ka_stop)）目标: $TARGETS" 失败

		if [ "$WCOUNT" -ge "$(ka_stop)" ]; then
			log "auto stop: $(ka_stop) failed rounds within 24h, giving up"
		op 自动放弃 "24h 内失败 $(ka_stop) 轮，停止保活" 已停止
			state_write stopped giveup "$TARGETS"
			rm -f "$PIDFILE"
			exit 0
		fi

		if [ "$CONSEC" -ge "$(ka_reload)" ]; then
			RELOADS=$((RELOADS + 1)); CONSEC=0
			state_write running reload "$TARGETS"
			reload_modem
			# 弹跳 30-90s + 拨号 20-90s，宽限拉长到 180s
			GRACE_UNTIL=$(($(date +%s) + 180))
		else
			state_write running fail "$TARGETS"
			op 自动重拨 "保活检测到链路失败" 已执行
			redial
			GRACE_UNTIL=$(($(date +%s) + 90))
		fi
	done
}

start_one() {
	# $1 = family (4|6); split daemon with its own state/pid files
	local fam=$1 pidfile="$BASE.$fam.pid" pid
	[ "$(ka_enable)" = 0 ] && return 0
	pid=$(cat "$pidfile" 2>/dev/null)
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		return 0
	fi
	rm -f "$pidfile" "$BASE.$fam.state"
	setsid sh -c "exec /usr/sbin/fm160-keepalive run $fam" </dev/null >/dev/null 2>&1 &
}

start() {
	if [ "$(ka_split)" = 1 ]; then
		start_one 4
		start_one 6
		return 0
	fi
	local pid
	[ "$(ka_enable)" = 0 ] && return 0
	pid=$(cat "$PIDFILE" 2>/dev/null)
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		return 0
	fi
	rm -f "$PIDFILE" "$STATE"
	setsid sh -c "exec /usr/sbin/fm160-keepalive run" </dev/null >/dev/null 2>&1 &
}

stop() {
	# always clear all three: a split->combined toggle must not leave an
	# orphan single-family daemon behind
	local f pid
	for f in "" .4 .6; do
		pid=$(cat "$BASE$f.pid" 2>/dev/null)
		if [ -n "$pid" ]; then
			kill "$pid" 2>/dev/null
			sleep 1
			kill -9 "$pid" 2>/dev/null
		fi
		rm -f "$BASE$f.pid" "$BASE$f.state"
	done
}

jstr() { printf '"%s"' "$(echo "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

# emit the counter JSON for one state file; $1 = suffix ("" | ".4" | ".6")
state_json() {
	local sfx=$1
	local state= idle last_check= last_targets= consec_fail=0 window_rounds=0
	local reloads=0 total_rounds=0 last_reload= last_reload_at=0
	[ -f "$BASE$sfx.state" ] && . "$BASE$sfx.state"
	local s=${state:-idle}
	[ -f "$BASE$sfx.pid" ] && kill -0 "$(cat "$BASE$sfx.pid")" 2>/dev/null || { [ "$s" = running ] && s=dead; }
	printf '{"state": "%s", "last_check": "%s", "last_targets": %s, "consec_fail": %s, "window_rounds": %s, "reloads": %s, "total_rounds": %s, "last_reload": "%s", "last_reload_at": %s}' \
		"$s" "$last_check" "$(jstr "$last_targets")" "${consec_fail:-0}" \
		"${window_rounds:-0}" "${reloads:-0}" "${total_rounds:-0}" \
		"$last_reload" "${last_reload_at:-0}"
}

status() {
	local ka_int ka_int6
	ka_int=$(ka_interval)
	ka_int6=$(ucig ka_interval6); [ -z "$ka_int6" ] && ka_int6=$((ka_int * 2))
	if [ "$(ka_split)" = 1 ]; then
		# per-family detail + a worst-of aggregate at top level so pages
		# reading only the classic fields keep working
		local st4=idle chk4= c4=0 w4=0 r4=0 t4=0 lr4= at4=0
		local st6=idle chk6= c6=0 w6=0 r6=0 t6=0 lr6= at6=0
		local state= last_check= consec_fail=0 window_rounds=0 reloads=0
		local total_rounds=0 last_reload= last_reload_at=0
		if [ -f "$BASE.4.state" ]; then
			state=; last_check=; consec_fail=0; window_rounds=0; reloads=0; total_rounds=0; last_reload=; last_reload_at=0
			. "$BASE.4.state"
			st4=${state:-idle}; chk4=$last_check; c4=${consec_fail:-0}; w4=${window_rounds:-0}
			r4=${reloads:-0}; t4=${total_rounds:-0}; lr4=$last_reload; at4=${last_reload_at:-0}
			kill -0 "$(cat "$BASE.4.pid" 2>/dev/null)" 2>/dev/null || { [ "$st4" = running ] && st4=dead; }
		fi
		if [ -f "$BASE.6.state" ]; then
			state=; last_check=; consec_fail=0; window_rounds=0; reloads=0; total_rounds=0; last_reload=; last_reload_at=0
			. "$BASE.6.state"
			st6=${state:-idle}; chk6=$last_check; c6=${consec_fail:-0}; w6=${window_rounds:-0}
			r6=${reloads:-0}; t6=${total_rounds:-0}; lr6=$last_reload; at6=${last_reload_at:-0}
			kill -0 "$(cat "$BASE.6.pid" 2>/dev/null)" 2>/dev/null || { [ "$st6" = running ] && st6=dead; }
		fi
		local agg_state="$st4/$st6"
		local agg_con=$c4; [ "$c6" -gt "$c4" ] && agg_con=$c6
		local agg_win=$w4; [ "$w6" -gt "$w4" ] && agg_win=$w6
		local agg_lr=$lr4
		{ [ "$lr4" = 0 ] || [ "$lr6" = 0 ]; } && agg_lr=0
		printf '{"enable": %s, "split": 1, "interval": %s, "interval6": %s,\n' "$(ka_enable)" "$ka_int" "$ka_int6"
		printf ' "reload_rounds": %s, "stop_rounds": %s,\n' "$(ka_reload)" "$(ka_stop)"
		printf ' "dns4": %s, "dns6": %s, "dns4_2": %s, "dns6_2": %s,\n' \
			"$(jstr "$(ka_dns4)")" "$(jstr "$(ka_dns6)")" "$(jstr "$(ka_dns4_2)")" "$(jstr "$(ka_dns6_2)")"
		printf ' "state": %s, "last_check": %s, "last_targets": %s,\n' \
			"$(jstr "$agg_state")" "$(jstr "v4:$chk4 v6:$chk6")" "$(jstr "v4+v6")"
		printf ' "consec_fail": %s, "window_rounds": %s, "reloads": %s, "total_rounds": %s,\n' \
			"$agg_con" "$agg_win" "$((r4 + r6))" "$((t4 + t6))"
		printf ' "last_reload": "%s", "last_reload_at": %s,\n' "$agg_lr" "$((at4 > at6 ? at4 : at6))"
		printf ' "v4": %s, "v6": %s}\n' "$(state_json .4)" "$(state_json .6)"
	else
		local state= idle last_check= last_targets= consec_fail=0 window_rounds=0 reloads=0 total_rounds=0 last_reload= last_reload_at=0
		[ -f "$STATE" ] && . "$STATE"
		local s=${state:-idle}
		[ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null || { [ "$s" = running ] && s=dead; }
		cat <<EOF
{"enable": $(ka_enable), "split": 0, "interval": $ka_int, "interval6": $ka_int6,
 "reload_rounds": $(ka_reload), "stop_rounds": $(ka_stop),
 "dns4": $(jstr "$(ka_dns4)"), "dns6": $(jstr "$(ka_dns6)"),
 "dns4_2": $(jstr "$(ka_dns4_2)"), "dns6_2": $(jstr "$(ka_dns6_2)"),
 "state": "$s", "last_check": "$last_check", "last_targets": $(jstr "$last_targets"),
 "consec_fail": ${consec_fail:-0}, "window_rounds": ${window_rounds:-0},
 "reloads": ${reloads:-0}, "total_rounds": ${total_rounds:-0},
 "last_reload": "$last_reload", "last_reload_at": ${last_reload_at:-0}}
EOF
	fi
}

case "$1" in
	run)
		[ -n "$2" ] && FAM=$2
		case "$FAM" in
			""|4|6) ;;
			*) echo "usage: $0 run [4|6]" >&2; exit 2 ;;
		esac
		if [ -n "$FAM" ]; then
			STATE=$BASE.$FAM.state
			PIDFILE=$BASE.$FAM.pid
		fi
		run ;;
	start)  start ;;
	stop)   stop ;;
	status) status ;;
	*) echo "usage: $0 {run [4|6]|start|stop|status}" >&2; exit 2 ;;
esac
